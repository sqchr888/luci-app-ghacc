#!/bin/sh /etc/rc.common
# OpenWrt procd 启动脚本 —— 安装到 /etc/init.d/ghacc
# 适配：QWRT / QSDK（dnsmasq 可能多实例，reload 走 killall -HUP 优先）
START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/ghacc-daemon
CONF=/etc/ghacc/ghacc.conf
MARK_START="# GHACC-BEGIN"
MARK_END="# GHACC-END"

# 读取配置里的 HOSTS 路径（默认 /etc/hosts）
HOSTS=/etc/hosts
[ -f "$CONF" ] && . "$CONF"
: "${HOSTS:=/etc/hosts}"

# 摘掉 hosts 标记块，保留其余内容
strip_hosts() {
    _f="$1"
    [ -f "$_f" ] || return 0
    grep -q "^${MARK_START}" "$_f" 2>/dev/null || return 0
    _t=$(mktemp 2>/dev/null) || _t="/tmp/.ghacc.strip.$$"
    awk -v s="$MARK_START" -v e="$MARK_END" '
        index($0, s) == 1 { inb = 1; next }
        index($0, e) == 1 { inb = 0; next }
        !inb { print }
    ' "$_f" > "$_t" 2>/dev/null
    if [ -s "$_t" ]; then
        cp -f "$_t" "$_f" 2>/dev/null
    else
        : > "$_f" 2>/dev/null
    fi
    rm -f "$_t"
}

# 热加载 dnsmasq：优先 killall（覆盖多实例），再 pid 文件，最后 init reload
reload_dns() {
    killall -HUP dnsmasq 2>/dev/null && return 0
    for _pf in /var/run/dnsmasq.pid /run/dnsmasq.pid /var/run/dnsmasq/dnsmasq.pid /tmp/dnsmasq.pid; do
        [ -f "$_pf" ] || continue
        kill -HUP "$(cat "$_pf" 2>/dev/null)" 2>/dev/null && return 0
    done
    /etc/init.d/dnsmasq reload >/dev/null 2>&1 && return 0
    return 1
}

start_service() {
    [ -x "$PROG" ] || { echo "未找到 $PROG"; exit 1; }
    procd_open_instance
    procd_set_param command "$PROG"
    # 崩溃后自动重启：5 秒内重试，最多 5 次（超出则判定为持续失败，不再重启）
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile /var/run/ghacc.pid
    procd_close_instance
}

stop_service() {
    # 停止时清理 hosts 标记块，避免残留失效 IP 拖慢解析
    strip_hosts "$HOSTS"
    strip_hosts "${ADDN_HOSTS:-/tmp/ghacc/hosts.addn}"
    # 摘掉 drop-in，否则 dnsmasq 会去读一个已不存在的 addn-hosts 文件
    rm -f "${DNSMASQ_CONFDIR:-/tmp/dnsmasq.d}/ghacc.conf"
    reload_dns
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger ghacc
}

status() {
    if [ -f /var/run/ghacc.pid ] && kill -0 "$(cat /var/run/ghacc.pid)" 2>/dev/null; then
        echo "ghacc-daemon 运行中 (pid $(cat /var/run/ghacc.pid))"
    else
        echo "ghacc-daemon 未运行"
    fi
    echo "--- 当前生效 IP ---"
    # 优先显示 dnsmasq 实际读取的 addn-hosts 文件
    for _f in "${ADDN_HOSTS:-/tmp/ghacc/hosts.addn}" "$HOSTS"; do
        [ -f "$_f" ] || continue
        grep -q '^# GHACC-BEGIN' "$_f" 2>/dev/null || continue
        echo "[${_f}]"
        awk '/^# GHACC-BEGIN/{f=1;next} /^# GHACC-END/{f=0;next} f' "$_f" 2>/dev/null
        break
    done
}

EXTRA_COMMANDS="status"
EXTRA_HELP="        status  查看运行状态与当前生效 IP"
