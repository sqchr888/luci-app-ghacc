config ghacc 'main'
	option enabled '1'
	option check_interval '15'
	option probe_timeout '3'
	option max_ips '2'
	option cooldown '120'
	option min_write_interval '60'
	option concurrency '8'
	option max_candidates '24'
	option domains 'github.com api.github.com codeload.github.com gist.github.com raw.githubusercontent.com gist.githubusercontent.com objects.githubusercontent.com avatars.githubusercontent.com'
	option auto_clean_log '1'
	option log_keep_days '3'
